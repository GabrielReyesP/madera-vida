EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Madera & Vida <noreply@maderavida.cl>

IVA_RATE=0.19
MINIMUM_WAGE=539000
WEEKLY_HOURS=44
