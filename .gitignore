# ============================================
# .gitignore - Madera & Vida
# ============================================

# Entorno virtual (el tuyo se llama porta)
porta/
venv/
env/

# Variables de entorno (NUNCA subir, contienen claves)
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/

# Django
*.log
logs/
staticfiles/
media/
db.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

# Tests / cobertura
htmlcov/
.coverage
coverage.xml